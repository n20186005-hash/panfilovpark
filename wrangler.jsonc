{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "panfilov-park-almaty",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
