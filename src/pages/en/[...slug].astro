---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubPage from '../../components/SubPage.astro';
import { subpages } from '../../content/subpages';
import { buildSubpageJsonLd } from '../../lib/schema';
import { SITE } from '../../i18n';

export const prerender = true;

export function getStaticPaths() {
  return subpages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props;
const base = (Astro.site?.href ?? SITE).replace(/\/$/, '');
const canonical = base + '/en/' + page.slug + '/';
const image = base + '/images/og-panfilov.png';
const jsonLd = buildSubpageJsonLd(page, canonical, image);
---

<BaseLayout
  locale="en"
  title={page.title}
  description={page.description}
  path={'/en/' + page.slug + '/'}
  jsonLd={jsonLd}
>
  <SubPage page={page} />
</BaseLayout>
