---
import BaseLayout from '../layouts/BaseLayout.astro';
const locale=Astro.url.pathname.startsWith('/ru/')?'ru':Astro.url.pathname.startsWith('/en/')?'en':'kk';
const copy={kk:{title:'Бет табылмады',text:'Сұралған бет жоқ. Саябақ гидіне оралыңыз.'},ru:{title:'Страница не найдена',text:'Запрошенной страницы нет. Вернитесь к путеводителю по парку.'},en:{title:'Page not found',text:'This page does not exist. Return to the park visitor guide.'}}[locale];
Astro.response.status=404;Astro.response.headers.set('x-robots-tag','noindex');Astro.response.headers.set('cache-control','no-store');
---
<BaseLayout locale={locale} title={copy.title+' | Panfilov Park'} description={copy.text} noindex><section class="container py-20"><p class="eyebrow">404</p><h1 class="section-title mt-5 text-4xl">{copy.title}</h1><p class="small mt-5">{copy.text}</p><p class="mt-7 flex flex-wrap gap-5"><a class="underline" href="/">Қазақша</a><a class="underline" href="/ru/">Русский</a><a class="underline" href="/en/">English</a></p></section></BaseLayout>
